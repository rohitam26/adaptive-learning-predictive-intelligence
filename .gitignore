.mypy_cache/
.pyre/
.pytype/

# --- Database & Cache Stores ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
postgres_data/

# --- Node.js & Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
