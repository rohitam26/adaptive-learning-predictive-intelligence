# --- IDEs & Editors ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Logs & Diagnostics ---
logs/
*.log
*.log.*
npm-debug.log*

# --- Scratch & Temporary Files ---
tmp/
temp/
scratch/
.system_generated/
