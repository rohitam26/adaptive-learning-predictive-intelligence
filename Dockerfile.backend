# Production Dockerfile for FastAPI Backend
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency resolution
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Copy project files
COPY pyproject.toml ./
RUN uv pip install --system fastapi uvicorn[standard] pydantic pydantic-settings \
    sqlalchemy psycopg2-binary aiosqlite python-jose[cryptography] passlib[bcrypt] \
    bcrypt python-multipart email-validator numpy pandas scipy scikit-learn \
    xgboost torch networkx shap

COPY backend ./backend
COPY ml ./ml
COPY data ./data
COPY artifacts ./artifacts

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

EXPOSE 8000

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
