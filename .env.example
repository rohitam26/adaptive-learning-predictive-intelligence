# ==========================================
# Adaptive Learning & Predictive Intelligence
# Environment Configuration Template
# ==========================================
# Copy this file to .env and customize for your environment.
# NEVER commit the active .env file or real credentials to version control.

# Application Identity
PROJECT_NAME="Adaptive Learning & Predictive Intelligence Platform"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security Configuration
# Generate a secure 32+ character key for production (e.g. openssl rand -hex 32)
SECRET_KEY="replace-with-a-secure-random-secret-key-minimum-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite fallback for instant zero-dependency development:
DATABASE_URL="sqlite:///./adaptive_learning.db"

# PostgreSQL Container / Production URL format:
# DATABASE_URL="postgresql://mintx_user:mintx_secure_password_2026@localhost:5432/adaptive_learning_platform"

# ML & Artifact Settings
MODEL_DIR="artifacts/models"
METRICS_DIR="artifacts/metrics"
RAW_DATA_DIR="data/raw"
PROCESSED_DATA_DIR="data/processed"

# Optional Tracking
MLFLOW_TRACKING_URI="sqlite:///./mlflow.db"
